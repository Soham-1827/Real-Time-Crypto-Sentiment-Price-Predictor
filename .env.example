# Redis (Upstash) - Get from https://upstash.com
UPSTASH_REDIS_URL=redis://default:YOUR_TOKEN@YOUR_ENDPOINT.upstash.io:6379
UPSTASH_REDIS_TOKEN=YOUR_TOKEN_HERE

# Supabase - Get from https://supabase.com (Phase 3)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY_HERE

# MLflow (Dagshub) - Get from https://dagshub.com (Phase 4)
MLFLOW_TRACKING_URI=https://dagshub.com/YOUR_USERNAME/crypto-ml-pipeline.mlflow
MLFLOW_TRACKING_USERNAME=YOUR_USERNAME
MLFLOW_TRACKING_PASSWORD=YOUR_TOKEN

# Optional: Binance API (not needed for public WebSocket streams)
BINANCE_API_KEY=
BINANCE_SECRET=

# Logging
LOG_LEVEL=INFO
